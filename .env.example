# Discord bot token — https://discord.com/developers/applications
DISCORD_TOKEN=

# Riot API key — https://developer.riotgames.com
RIOT_API_KEY=

# PostgreSQL connection string (see docker-compose.yml)
DATABASE_URL=postgresql://calp:calp@localhost:5432/calp

# Discord server and channel receiving the daily recap
GUILD_ID=
RECAP_CHANNEL_ID=

# Host port exposed by docker-compose
POSTGRES_PORT=5432
