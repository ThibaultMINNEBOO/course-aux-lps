{
  "name": "calp-bot",
  "version": "0.1.0",
  "private": true,
  "description": "A Discord bot for CALP Community",
  "type": "module",
  "engines": {
    "node": ">=22.23.2 <27"
  },
  "scripts": {
    "dev": "spraxium dev",
    "build": "spraxium build",
    "start": "spraxium start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@spraxium/common": "^0.3.0",
    "@spraxium/components": "^1.0.0",
    "@spraxium/core": "^0.3.0",
    "@spraxium/env": "^0.3.0",
    "@spraxium/logger": "^0.3.0",
    "@spraxium/schedule": "^1.0.0",
    "discord.js": "^14.27.0",
    "luxon": "^3.7.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@spraxium/cli": "^0.4.0",
    "@swc/core": "^1.16.13",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
